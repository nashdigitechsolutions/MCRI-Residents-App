<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (no user-installed CAs, which blocks most
     traffic-interception proxies on non-rooted devices). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
